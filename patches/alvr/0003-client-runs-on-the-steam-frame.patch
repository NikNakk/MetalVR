diff --git a/alvr/client_openxr/src/lib.rs b/alvr/client_openxr/src/lib.rs
index 3e35add..d98840c 100644
--- a/alvr/client_openxr/src/lib.rs
+++ b/alvr/client_openxr/src/lib.rs
@@ -185,7 +185,8 @@ pub fn entry_point() {
     {
         exts.khr_android_create_instance = true;
     }
-    exts.khr_convert_timespec_time = true;
+    // Valve's runtime on the Steam Frame has no timespec conversion; the clock is then not the runtime's
+    exts.khr_convert_timespec_time = available_extensions.khr_convert_timespec_time;
     exts.khr_opengl_es_enable = true;
     exts.other = available_extensions
         .other
@@ -525,6 +526,8 @@ pub fn entry_point() {
 
 #[allow(unused)]
 fn xr_runtime_now(xr_instance: &xr::Instance) -> Option<xr::Time> {
+    // without XR_KHR_convert_timespec_time (the Steam Frame) the runtime's clock cannot be read
+    xr_instance.exts().khr_convert_timespec_time.as_ref()?;
     xr_instance
         .now()
         .ok()
