#!/bin/zsh
# metalvr-rift: a headset on this Mac's own display and USB, from a MetalVR release to a game in the headset: an
# Oculus Rift CV1 or Rift S (docs/headsets/); run as metalvr-lighthouse, an HTC Vive, Vive Pro, Vive Pro 2 or
# Valve Index; run as metalvr-psvr2, a PlayStation VR2 through Sony's PC adapter (docs/HEADSETS.md).
#
#   metalvr-rift install          copy this release into ~/.metalsharp/metalvr-runtime and make MetalVR the Steam
#                                 prefix's OpenXR runtime
#   metalvr-rift display [--undo] let macOS show the headset's display (asks for your password; once per Mac)
#   metalvr-rift setup            register MetalVR's SteamVR driver with the Steam prefix's SteamVR
#   metalvr-rift start [options]  start the server and wait for the headset (options go to metalvrd, e.g.
#                                 --refresh 120 for an Index, --pro2-mode 2 for a Vive Pro 2)
#   metalvr-rift stop             stop the server (the headset's display turns off)
#   metalvr-rift steamvr          start the server if needed, then SteamVR on the headset
#   metalvr-rift game APPID       start the server if needed, then a Steam game's VR entry on the headset
#   metalvr-rift status           what is installed, set up and running
set -e
H=${0:A:h:h}                       # this release, unpacked or installed
MS=$HOME/.metalsharp
T=$MS/metalvr-runtime              # where MetalSharp looks for MetalVR
PORT=${METALVR_PORT:-37913}
if [[ ${0:t} == metalvr-lighthouse ]]; then
  FAMILY=lighthouse SERVER="Lighthouse server" VIDEO="DisplayPort (or a Vive's HDMI)"
elif [[ ${0:t} == metalvr-psvr2 ]]; then
  FAMILY=psvr2 SERVER="PlayStation VR2 server" VIDEO="PC adapter's DisplayPort and USB (and its power)"
else
  FAMILY=rift SERVER="Rift server" VIDEO="HDMI (CV1) or DisplayPort (Rift S)"
fi
LOG=$MS/logs/$FAMILY-server.log
LIB=/Library/Displays/Contents/Resources/Overrides

die() { print -r -- "!! $*" >&2; exit 1; }
need_metalsharp() {
  [[ -f $MS/prefix-steam/system.reg ]] ||
    die "no MetalSharp Steam prefix in $MS/prefix-steam: install MetalSharp and its Windows Steam first"
}
need_installed() { [[ -x $T/bin/metalvrd ]] || die "MetalVR is not installed: run '${0:t} install' from the release"; }

# whether a USB device of this vendor and product (decimal) is plugged in
usb_has() {
  ioreg -p IOUSB -l -w0 2>/dev/null | awk -v V=$1 -v P=$2 '
    /\+-o / { if (v == V && p == P) f = 1; v = ""; p = "" }
    /"idVendor" = / { v = $NF }
    /"idProduct" = / { p = $NF }
    END { if (v == V && p == P) f = 1; exit !f }'
}
# the headset on USB, by its IDs (docs/HEADSETS.md); empty if none of this family is
headset_plugged() {
  if [[ $FAMILY == psvr2 ]]; then
    usb_has 1356 3294 && { print "PlayStation VR2"; return; } # 054c:0cde
  elif [[ $FAMILY == rift ]]; then
    usb_has 10291 81 && { print "Rift S"; return; }          # 2833:0051
    usb_has 10291 49 && { print "Rift CV1"; return; }        # 2833:0031
  else
    usb_has 3028 834 && { print "Vive Pro 2"; return; }      # 0bb4:0342
    { usb_has 3028 777 || usb_has 3028 782; } && { print "Vive Pro"; return; } # 0bb4:0309, 030e
    usb_has 3028 11399 && { print "Vive"; return; }          # 0bb4:2c87
    usb_has 10462 8960 && { print "Valve Index"; return; }   # 28de:2300 without an HTC mainboard
  fi
  return 0
}
sensors() { ioreg -p IOUSB -l -w0 2>/dev/null | grep -c '"USB Product Name" = "Rift Sensor"$' || true; }
# the display overrides this family's headsets need, one a line: vendor:product:name
overrides() {
  # macOS does not hide the PlayStation VR2's display (it ships no override for it): none
  if [[ $FAMILY == psvr2 ]]; then
    return 0
  elif [[ $FAMILY == rift ]]; then
    print -l "3ed2:4:Rift CV1" "3ed2:12:Rift S"
  else
    print -l "22d2:aa01:Vive" "22d2:aa02:Vive Pro" "22d2:aa03:Vive Pro" "22d2:aa04:Vive Pro 2" "5996:91a8:Index"
  fi
}
lifted() {
  local f=$LIB/DisplayVendorID-$1/DisplayProductID-$2
  [[ -f $f ]] && /usr/libexec/PlistBuddy -c 'Print :is-hmd' $f 2>/dev/null | grep -q false
}
# whether macOS shows any of this family's displays
override_on() {
  [[ $FAMILY == psvr2 ]] && return 0
  local o rest
  overrides | while IFS= read -r o; do
    rest=${o#*:}
    lifted ${o%%:*} ${rest%%:*} && return 0
  done
  return 1
}
server_up() { pgrep -x metalvrd >/dev/null && nc -z 127.0.0.1 $PORT 2>/dev/null; }

start_server() {
  need_installed
  if server_up; then print -r -- "the $SERVER is running"; return; fi
  pgrep -x metalvrd >/dev/null && die "metalvrd is running but not answering on port $PORT: stop it first ('${0:t} stop')"
  override_on || print -r -- "warning: macOS may keep the headset's display hidden: run '${0:t} display' once" >&2
  local model=$(headset_plugged)
  [[ -n $model ]] || print -r -- "warning: no headset of this kind on USB yet: plug in its USB and its $VIDEO" >&2
  mkdir -p ${LOG:h}
  nohup $T/bin/metalvr $FAMILY --verbose "$@" >$LOG 2>&1 &!
  local n=0
  until server_up || (( n >= 30 )); do sleep 1; n=$((n + 1)); done
  server_up || die "the $SERVER did not start: see $LOG"
  print -r -- "the $SERVER is running (log: $LOG)"
  # the headset comes on once its HID answers; its display appears in macOS a few seconds later
  n=0
  until grep -q "rift: drawing on the headset's display" $LOG 2>/dev/null || (( n >= 20 )); do sleep 1; n=$((n + 1)); done
  if grep -q "rift: drawing on the headset's display" $LOG; then
    print -r -- "the headset is on and showing MetalVR's home"
  elif grep -q 'rift: headset on' $LOG; then
    print -r -- "warning: the headset is on, but macOS has not shown its display: check '${0:t} display' and its video cable" >&2
  else
    print -r -- "waiting for the headset: plug in its USB and its $VIDEO (the server keeps waiting; log: $LOG)" >&2
  fi
}

case ${1:-status} in
install)
  need_metalsharp
  [[ -x $H/bin/metalvrd && -d $H/lib/metalvr ]] || die "run this from an unpacked MetalVR release"
  [[ $H == ${T:A} ]] && { print -r -- "already installed in $T"; exit 0; }
  pgrep -x metalvrd >/dev/null && die "metalvrd is running: '${0:t} stop' first"
  # a downloaded archive is quarantined, and Gatekeeper would refuse the unsigned server
  xattr -dr com.apple.quarantine $H 2>/dev/null || true
  rm -rf $T; mkdir -p $T $MS/metalvr
  cp -Rp $H/bin $H/lib $H/share $T/
  [[ -f $MS/metalvr/system.reg.orig ]] || cp -p $MS/prefix-steam/system.reg $MS/metalvr/system.reg.orig
  $T/bin/metalvr prefix
  print -r -- "installed: $(cat $T/lib/metalvr/VERSION)"
  print -r -- "next: ${0:t} display, then ${0:t} setup"
  ;;
display)
  shift
  [[ $FAMILY == psvr2 ]] && { print -r -- "macOS shows the PlayStation VR2's display as it is: nothing to do"; exit 0; }
  # the release's own helper when this runs before it is installed
  B=$T/bin/metalvr; [[ -x $B ]] || B=$H/bin/metalvr
  exec $B display $FAMILY "$@"
  ;;
setup)
  need_installed; need_metalsharp
  VP=$(find $MS/prefix-steam/drive_c/users -maxdepth 5 -name openvrpaths.vrpath 2>/dev/null | head -1)
  [[ -n $VP ]] || die "SteamVR has not run in the Steam prefix yet: install SteamVR in Steam, start it once, quit it, then run this again"
  pgrep -f 'vrserver\.exe' >/dev/null && die "quit SteamVR first: it writes its settings back when it quits"
  $T/bin/metalvr prefix
  $T/bin/metalvr steamvr
  print -r -- "SteamVR is set up for the headset. Quit Steam if it is running, so it starts again with these settings."
  ;;
start)
  shift
  start_server "$@"
  ;;
stop)
  if pgrep -x metalvrd >/dev/null; then
    pkill -INT -x metalvrd
    n=0; until ! pgrep -x metalvrd >/dev/null || (( n >= 10 )); do sleep 1; n=$((n + 1)); done
    pgrep -x metalvrd >/dev/null && die "metalvrd did not stop"
    print -r -- "stopped"
  else
    print -r -- "the $SERVER is not running"
  fi
  ;;
steamvr)
  start_server
  $T/bin/metalvr launch steamvr
  ;;
game)
  [[ ${2:-} == <-> ]] || die "usage: ${0:t} game APPID (the number in the game's Steam store address)"
  start_server
  $T/bin/metalvr launch $2
  ;;
status)
  print -r -- "release:  $(cat $T/lib/metalvr/VERSION 2>/dev/null || print 'not installed')"
  overrides | while IFS= read -r o; do
    rest=${o#*:}; v=${o%%:*} p=${rest%%:*} name=${rest#*:}
    lifted $v $p && print -r -- "display:  macOS shows the $name's display ($v:$p)" ||
      print -r -- "display:  the $name's ($v:$p) is hidden by macOS (${0:t} display)"
  done
  model=$(headset_plugged)
  [[ -n $model ]] && print -r -- "headset:  a $model is on USB" || print -r -- "headset:  none of this kind on USB"
  [[ $FAMILY == rift && $model == "Rift CV1" ]] && print -r -- "sensors:  $(sensors) Rift Sensor(s) on USB"
  if server_up; then print -r -- "server:   running (log: $LOG)"; else print -r -- "server:   not running (${0:t} start)"; fi
  VP=$(find $MS/prefix-steam/drive_c/users -maxdepth 5 -name openvrpaths.vrpath 2>/dev/null | head -1)
  if [[ -n $VP ]] && grep -q 'metalvr' $VP; then print -r -- "steamvr:  MetalVR's driver is registered"
  else print -r -- "steamvr:  not set up (${0:t} setup)"; fi
  ;;
*)
  sed -n '2,15p' $0 | sed 's/^# \{0,1\}//'
  ;;
esac
